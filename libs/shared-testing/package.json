{
  "name": "@cli-ops/shared-testing",
  "version": "1.0.0",
  "description": "Testing utilities and helpers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./migrations/*": "./fixtures/migrations/*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "echo \"No tests yet\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "testing",
    "utilities",
    "helpers"
  ],
  "dependencies": {
    "@oclif/test": "^4.1.15",
    "@cli-ops/shared-types": "workspace:*",
    "zod": "^3.22.4"
  },
  "files": [
    "dist",
    "fixtures",
    "migrations"
  ],
  "publishConfig": {
    "access": "public"
  }
}
