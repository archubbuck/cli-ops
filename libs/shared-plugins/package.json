    "@cli-ops/shared-logger": "workspace:*",
    "@cli-ops/shared-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
