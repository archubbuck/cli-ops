{
  "name": "@cli-ops/shared-plugins",
  "version": "4.0.0",
  "description": "Plugin system utilities for CLI applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
