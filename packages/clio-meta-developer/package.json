{
  "name": "@cli-ops/clio-meta-developer",
  "version": "1.0.0",
  "description": "Meta-package for developers - installs clio with fetch and repo plugins",
  "keywords": [
    "clio",
    "meta-package",
    "developer",
    "devtools"
  ],
  "dependencies": {
    "@cli-ops/clio": "workspace:*",
    "@cli-ops/clio-plugin-fetch": "workspace:*",
    "@cli-ops/clio-plugin-repo": "workspace:*"
  },
  "scripts": {
    "postinstall": "node postinstall.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
