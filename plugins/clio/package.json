{
  "name": "@cli-ops/clio",
  "version": "1.0.0",
  "description": "Foundational plugin manager CLI for CLI Ops tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clio": "./bin/run.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "node --loader ts-node/esm ./bin/dev.js",
    "test": "echo \"No tests yet\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "plugin-manager",
    "productivity",
    "development-tools"
  ],
  "dependencies": {
    "@oclif/core": "^4.0.31",
    "@oclif/plugin-autocomplete": "^3.2.11",
    "@oclif/plugin-help": "^6.2.18",
    "@oclif/plugin-plugins": "^5.4.15",
    "@oclif/plugin-version": "^2.2.19",
    "@cli-ops/clio-plugin-tasks": "workspace:*",
    "@cli-ops/shared-commands": "workspace:*",
    "@cli-ops/shared-config": "workspace:*",
    "@cli-ops/shared-core": "workspace:*",
    "@cli-ops/shared-exit-codes": "workspace:*",
    "@cli-ops/shared-formatter": "workspace:*",
    "@cli-ops/shared-history": "workspace:*",
    "@cli-ops/shared-hooks": "workspace:*",
    "@cli-ops/shared-logger": "workspace:*",
    "@cli-ops/shared-plugins": "workspace:*",
    "@cli-ops/shared-types": "workspace:*",
    "@cli-ops/shared-ui": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "oclif": {
    "bin": "clio",
    "dirname": "clio",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-version",
      "@oclif/plugin-autocomplete",
      "@cli-ops/clio-plugin-tasks"
    ],
    "topicSeparator": ":",
    "topics": {
      "config": {
        "description": "Manage clio configuration"
      },
      "history": {
        "description": "View command history"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init",
      "prerun": "./dist/hooks/prerun",
      "postrun": "./dist/hooks/postrun",
      "command_not_found": "./dist/hooks/command-not-found"
    }
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
