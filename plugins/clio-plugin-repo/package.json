{
  "name": "@cli-ops/clio-plugin-repo",
  "version": "2.0.0",
  "description": "Developer tools plugin for clio with Git and GitHub integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "node --loader ts-node/esm ./bin/dev.js",
    "test": "echo \"No tests yet\"",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/perf-check.js"
  },
  "keywords": [
    "cli",
    "clio",
    "clio-plugin",
    "git",
    "github",
    "devtools",
    "repo"
  ],
  "dependencies": {
    "@oclif/core": "^4.0.31",
    "@cli-ops/shared-commands": "workspace:*",
    "@cli-ops/shared-config": "workspace:*",
    "@cli-ops/shared-core": "workspace:*",
    "@cli-ops/shared-exit-codes": "workspace:*",
    "@cli-ops/shared-formatter": "workspace:*",
    "@cli-ops/shared-history": "workspace:*",
    "@cli-ops/shared-hooks": "workspace:*",
    "@cli-ops/shared-logger": "workspace:*",
    "@cli-ops/shared-plugins": "workspace:*",
    "@cli-ops/shared-prompts": "workspace:*",
    "@cli-ops/shared-services": "workspace:*",
    "@cli-ops/shared-types": "workspace:*",
    "@cli-ops/shared-ui": "workspace:*",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@cli-ops/clio": "^1.0.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "oclif": {
    "bin": "clio",
    "dirname": "clio",
    "commands": "./dist/commands",
    "topicSeparator": ":",
    "topics": {
      "repo": {
        "description": "Repository management"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init",
      "prerun": "./dist/hooks/prerun",
      "postrun": "./dist/hooks/postrun",
      "command_not_found": "./dist/hooks/command-not-found"
    }
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
